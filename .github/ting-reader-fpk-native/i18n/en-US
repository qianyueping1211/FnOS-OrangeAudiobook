[common]
displayName="Orange Audiobook"
maintainer="Yueping"
distributor="Yueping"
distributorUrl="https://github.com/qianyueping1211/FnOS-OrangeAudiobook"
desc="Orange Audiobook: native fnOS audiobook library, scraping, playback and private updates. Based on Ting Reader, AGPL-3.0-only."

[entry]
title="Orange Audiobook"

[install]
stepTitle="App Configuration"
portLabel="Access Port"
portRequired="Please enter a port number"
portPattern="Port number must be digits only"
storageLabel="Audiobook Storage Path"
storageHelpText="<strong>Storage Info:</strong><br/>1. This field is <strong>optional</strong>. If left empty, the system will use the default <strong>@appshare/ting-reader/storage</strong> directory on the installation volume.<br/>2. If you specify a custom path, please go to application settings to add the path permission.<br/>3. Other application data (database, plugins, cache) will be automatically stored in corresponding subdirectories under <strong>@appshare/ting-reader</strong>, no configuration needed."

[uninstall]
stepTitle="Confirm Uninstall"
helpText="You are about to uninstall Ting Reader. Please choose whether to clean up application data:"
label="Data Cleanup Options"
option1Label="Clean database and config (data)"
option2Label="Clean plugins (plugins)"
option3Label="Clean temporary files (temp)"
noteHelpText="<strong>Note:</strong><br/>1. If nothing is selected, all data will be preserved.<br/>2. To protect your audiobook data, the uninstaller will <strong>not</strong> clean audio files in the storage directory. To delete them, please go to File Manager and clean up manually."
