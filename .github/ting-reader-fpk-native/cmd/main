#!/bin/bash

set -Eeuo pipefail
ACTION="${1:-status}"
case "$ACTION" in start|stop|status) ;; *) exit 1 ;; esac
APP_UID="$(id -u ting-reader)"
APP_GID="$(id -g ting-reader)"
[ "$APP_UID" -ne 0 ] || { echo "Refusing to run the service as root." >&2; exit 1; }
if [ "$(id -u)" -eq 0 ]; then
    if [ "$ACTION" = start ]; then
        install -d -o "$APP_UID" -g "$APP_GID" -m 755 "$TRIM_PKGVAR" "$TRIM_PKGVAR/run"
        ln -sfn -- "$TRIM_PKGVAR/run/ting-reader.sock" "$TRIM_APPDEST/ting-reader.sock"
    fi
    # Every long-running process, including FFmpeg and plugins, is unprivileged.
    exec runuser -u ting-reader -- /bin/bash "$0" "$ACTION"
fi
[ "$(id -u)" -eq "$APP_UID" ] || { echo "Unexpected service user." >&2; exit 1; }
LOG_FILE="${TRIM_TEMP_LOGFILE:-/dev/null}"
PID_FILE="$TRIM_PKGVAR/run/app.pid"
SERVER_LOG="$TRIM_PKGVAR/run/server.log"
exec 9>"$TRIM_PKGVAR/run/control.lock"
flock -x 9

export RUST_LOG=info
export FNNAS_GATEWAY_ONLY=1
export FNNAS_FPK_INITIAL_ADMIN_LANGUAGE=1
export FNNAS_FPK_INITIAL_TIME_ZONE=1
GATEWAY_SOCKET="${TRIM_PKGVAR}/run/ting-reader.sock"
export FNNAS_GATEWAY_SOCKET="$GATEWAY_SOCKET"
export FNNAS_GATEWAY_PREFIX="/app/ting-reader"


IFS=':' read -r -a SHARES <<< "$TRIM_DATA_SHARE_PATHS"
[ "${#SHARES[@]}" -eq 4 ] || { echo "Expected four fnOS data shares." >&2; exit 1; }

export TING_STORAGE__DATA_DIR="${SHARES[0]}"
export TING_STORAGE__TEMP_DIR="${SHARES[3]}"
export TING_PLUGINS__PLUGIN_DIR="${SHARES[2]}"
export TING_DATABASE__PATH="${SHARES[0]}/ting-reader.db"

export DATA_DIR="${SHARES[0]}"
export STORAGE_DIR="${SHARES[1]}"
export PLUGINS_DIR="${SHARES[2]}"
export TEMP_DIR="${SHARES[3]}"

export TING_STORAGE__LOCAL_STORAGE_ROOT="${SHARES[1]}"
export TING_PLUGINS__PREINSTALLED_DIR="${TRIM_APPDEST}/server/preinstalled-plugins"

if [ -n "${wizard_storage_path:-}" ]; then
    export STORAGE_DIR="$wizard_storage_path"
    export TING_STORAGE__LOCAL_STORAGE_ROOT="$wizard_storage_path"
fi

export STATIC_DIR="${TRIM_APPDEST}/server/static"
export TING_CONFIG_PATH="${TRIM_APPDEST}/server/config.toml"
export LD_LIBRARY_PATH="${TRIM_APPDEST}/server/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

CMD="${TRIM_APPDEST}/server/ting-reader"

log_msg() {
    printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >&2
    if [ "$LOG_FILE" != /dev/null ]; then
        printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE" || true
    fi
}

check_process() {
    local pid="$1" owner executable
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    owner="$(stat -c %u "/proc/$pid" 2>/dev/null)" || return 1
    executable="$(readlink -f "/proc/$pid/exe" 2>/dev/null)" || return 1
    [ "$owner" = "$APP_UID" ] && [ "$executable" = "$(readlink -f "$CMD")" ]
}

healthy() {
    [ -S "$GATEWAY_SOCKET" ] &&
        curl --silent --fail --max-time 2 --unix-socket "$GATEWAY_SOCKET" http://localhost/api/health |
        grep -q '"status"[[:space:]]*:[[:space:]]*"healthy"'
}

status() {
    [ -r "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE")"
    check_process "$pid" && healthy
}

stop_process() {
    local pid count
    if [ -r "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE")"
        if check_process "$pid"; then
            kill -TERM "$pid"
            for count in {1..15}; do
                check_process "$pid" || break
                sleep 1
            done
            if check_process "$pid"; then kill -KILL "$pid"; fi
        fi
    fi
    rm -f -- "$PID_FILE" "$GATEWAY_SOCKET"
}

start_process() {
    if status; then return 0; fi
    # Reap an unready previous service before starting another copy.
    stop_process
    if ! "$CMD" --help >/dev/null 2>> "$LOG_FILE"; then
        log_msg "Server executable check failed."
        return 1
    fi
    (
        cd "$TRIM_APPDEST/server"
        # Do not let the detached service inherit the lifecycle lock.
        nohup "$CMD" 9>&- >> "$SERVER_LOG" 2>&1 </dev/null &
        printf '%s\n' "$!" > "$PID_FILE"
    )
    local pid count
    pid="$(cat "$PID_FILE")"
    for count in {1..60}; do
        if ! check_process "$pid"; then
            log_msg "Service exited during startup; recent server output follows."
            tail -n 40 "$SERVER_LOG" >&2
            return 1
        fi
        if healthy; then
            log_msg "Gateway ready; service UID $APP_UID, no TCP listener."
            return 0
        fi
        sleep 1
    done
    log_msg "Gateway health check timed out; see $SERVER_LOG."
    stop_process
    return 1
}

case "$ACTION" in
    start) start_process ;;
    stop) stop_process ;;
    status) if status; then exit 0; else exit 3; fi ;;
esac
